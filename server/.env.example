PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/resellring
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Comma-separated campus email domains. Leave empty to allow any email (dev only).
ALLOWED_EMAIL_DOMAINS=college.edu
# Optional: if unset, images are stored on local disk (server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
